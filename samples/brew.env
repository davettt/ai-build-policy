# Sample from the guidebook (MIT licence). It shows the Homebrew install-safety settings I use;
# read it and adapt it to your project rather than copying it as is.
# Not covered in the guide: an extra for Homebrew installs, in the spirit of chapter 4.
# Homebrew install safety. These go in ~/.homebrew/brew.env, which Homebrew reads
# on every run (interactive or not).
# Verify each bottle's build provenance with gh (presence-based: any value turns it on).
HOMEBREW_VERIFY_ATTESTATIONS=1
# Refuse HTTPS-to-HTTP download redirects.
HOMEBREW_NO_INSECURE_REDIRECT=1
# Refuse casks without a checksum.
HOMEBREW_CASK_OPTS=--require-sha
