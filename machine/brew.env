# Homebrew install safety. policy setup-machine merges these into ~/.homebrew/brew.env,
# which Homebrew reads on every run (interactive or not).
# Verify each bottle's build provenance with gh (presence-based: any value turns it on).
HOMEBREW_VERIFY_ATTESTATIONS=1
# Refuse HTTPS-to-HTTP download redirects.
HOMEBREW_NO_INSECURE_REDIRECT=1
# Refuse casks without a checksum.
HOMEBREW_CASK_OPTS=--require-sha
